		len_maggiore = i
	ALTRIMENTI
		len_maggiore = k
FINE
MENTRE (len_maggiore >= 1)
	num_i = elemento di num_1 in posizione i
	num_k = elemento di num_2 in posizione k
	SE (i < 1)
		ALLORA
			num_i = 0
	FINE
	SE (k < 1)
		ALLORA
			num_k = 0
	FINE
