# Ignore everything by default
*

# Allow directories (needed for Git to traverse the tree)
!*/

# But allow .tex and .pdf files
!*.tex
!*.pdf

# Exclude libri/ directories and their contents everywhere
libri/
**/libri/**

# LaTeX auxiliary files (explicitly ignored even if they match patterns above)
*.aux
*.log
*.out
*.toc
*.synctex.gz
*.synctex(busy)
*.dvi

# Other files to ignore
*.exe
*.o
*.zip
*.docx
*.txt
*.c
*.cpp
*.h
*.jpg
*.jpeg
*.png
*.gif
